# Claude Code local settings
# Ignore .claude CONTENTS (not the dir itself — git can't re-include inside an
# excluded directory) so skills can be tracked while launch.json and worktrees
# stay local.
.claude/*
!.claude/skills/

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Local env files
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Vite
*.local

# TypeScript
*.tsbuildinfo

# Supabase (project-level — supabase/.gitignore covers the rest)
supabase/.branches
supabase/.temp
